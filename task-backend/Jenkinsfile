pipeline {
    agent any

    environment {
        REGISTRY_USER = 'zchadli'
        IMAGE = "${REGISTRY_USER}/task-backend"
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Build & Test') {
            steps {
                dir('task-backend') {
                    sh '''
                        docker run --rm --network host \
                            -v "$PWD":/app \
                            -w /app \
                            maven:3.9-eclipse-temurin-21 \
                            mvn -B verify
                    '''
                }
            }
        }

        stage('Get Version') {
            steps {
                dir('task-backend') {
                    script {
                        env.TAG = sh(
                            script: '''
                        awk '
                            /<parent>/ { parent=1 }
                            /<\\/parent>/ { parent=0; next }
                            !parent && /<version>/ {
                                gsub(/.*<version>/, "")
                                gsub(/<\\/version>.*/, "")
                                print
                                exit
                            }
                        ' pom.xml
                    ''',
                            returnStdout: true
                        ).trim()

                        if (!env.TAG) {
                            error('Version introuvable dans pom.xml')
                        }

                        echo "Application version: ${env.TAG}"
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('task-backend') {
                    sh '''
                        docker build --network host \
                            -t ${IMAGE}:${TAG} .
                    '''
                }
            }
        }

        stage('Push') {
            steps {
                withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub',
                            usernameVariable: 'DH_USER',
                            passwordVariable: 'DH_PASS'
                        )
                    ]) {
                    sh '''
                        echo "$DH_PASS" | docker login \
                            -u "$DH_USER" --password-stdin

                        docker push ${IMAGE}:${TAG}
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('task-backend') {
                    sh '''
                        helm upgrade --install task-backend ./chart \
                            --set-string image.repository=${IMAGE} \
                            --set-string image.tag=${TAG} \
                            --namespace task \
                            --create-namespace \
                            --wait \
                            --timeout 3m
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline successful! Deployed version: ${TAG}"
        }

        failure {
            echo 'Pipeline en échec'
        }
    }
}