
pipeline {
    agent any

    environment {
        IMAGE = 'zchadli/task-backend'
        DOCKER_CREDENTIALS = 'dockerhub'

        SONAR_PROJECT_KEY = 'task-backend'
        SONAR_SERVER = 'SonarQube'
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            when {
                anyOf {
                    expression {
                        env.CHANGE_ID != null &&
                        env.CHANGE_TARGET == 'prod'
                    }
                    branch 'prod'
                }
            }
            steps {
                dir('task-backend') {
                    sh '''
                        docker run --rm --network host \
                            -v "$PWD":/app \
                            -w /app \
                            maven:3.9-eclipse-temurin-21 \
                            mvn -B clean verify
                    '''
                }
            }
        }

        stage('Get Version') {
            when {
                branch 'prod'
            }
            steps {
                dir('task-backend') {
                    script {
                        env.TAG = sh(
                            script: '''
                                docker run --rm \
                                    -v "$PWD":/app \
                                    -w /app \
                                    maven:3.9-eclipse-temurin-21 \
                                    mvn -q -DforceStdout \
                                    help:evaluate \
                                    -Dexpression=project.version
                            ''',
                            returnStdout: true
                        ).trim()

                        if (!env.TAG) {
                            error('Version not found')
                        }

                        echo "Application version: ${env.TAG}"
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            when {
                anyOf {
                    expression {
                        env.CHANGE_ID != null &&
                        env.CHANGE_TARGET == 'prod'
                    }
                    branch 'prod'
                }
            }
            steps {
                dir('task-backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            docker run --rm --network host \
                                -v "$PWD":/app \
                                -w /app \
                                -e SONAR_HOST_URL="$SONAR_HOST_URL" \
                                -e SONAR_AUTH_TOKEN="$SONAR_AUTH_TOKEN" \
                                -e CHANGE_ID="$CHANGE_ID" \
                                -e CHANGE_BRANCH="$CHANGE_BRANCH" \
                                -e CHANGE_TARGET="$CHANGE_TARGET" \
                                maven:3.9-eclipse-temurin-21 \
                                sh -c '
                                    if [ -n "$CHANGE_ID" ]; then
                                        mvn -B sonar:sonar \
                                            -Dsonar.projectKey=task-backend \
                                            -Dsonar.host.url="$SONAR_HOST_URL" \
                                            -Dsonar.token="$SONAR_AUTH_TOKEN" \
                                            -Dsonar.pullrequest.key="$CHANGE_ID" \
                                            -Dsonar.pullrequest.branch="$CHANGE_BRANCH" \
                                            -Dsonar.pullrequest.base="$CHANGE_TARGET"
                                    else
                                        mvn -B sonar:sonar \
                                            -Dsonar.projectKey=task-backend \
                                            -Dsonar.host.url="$SONAR_HOST_URL" \
                                            -Dsonar.token="$SONAR_AUTH_TOKEN"
                                    fi
                                '
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            when {
                anyOf {
                    expression {
                        env.CHANGE_ID != null &&
                        env.CHANGE_TARGET == 'prod'
                    }
                    branch 'prod'
                }
            }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build') {
            when {
                branch 'prod'
            }
            steps {
                dir('task-backend') {
                    sh '''
                        docker build \
                            -t ${IMAGE}:${TAG} \
                            -t ${IMAGE}:latest .
                    '''
                }
            }
        }

        stage('Docker Push') {
            when {
                branch 'prod'
            }
            steps {
                withCredentials([
                        usernamePassword(
                            credentialsId: 'dockerhub',
                            usernameVariable: 'DH_USER',
                            passwordVariable: 'DH_PASS'
                        )
                    ]) {
                    sh '''
                        echo "$DH_PASS" | docker login \
                            -u "$DH_USER" --password-stdin

                        docker push ${IMAGE}:${TAG}
                        docker push ${IMAGE}:latest

                        docker logout
                    '''
                }
            }
        }

    }

    post {
        success {
            echo "CI/CD successful: ${IMAGE}:${TAG}"
            echo 'Light Cloud handles production deployment automatically.'
        }

        failure {
            echo 'Pipeline failed!'
        }

        always {
            echo 'Pipeline finished.'
        }
    }
}