pipeline {
  agent any
  environment {
    IMAGE = "task-backend"
    TAG   = "${env.BUILD_NUMBER}"
  }
  stages {
    stage('Build & Test') {
      steps {
        sh 'docker run --rm -v "$PWD":/app -w /app maven:3.9-eclipse-temurin-21 mvn -B verify'
      }
    }
    stage('Docker build') {
      steps {
        sh 'docker build -t $IMAGE:$TAG .'
      }
    }
  }
  post {
    failure { echo 'Pipeline en échec' }
  }
}