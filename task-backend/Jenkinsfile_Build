pipeline {
  agent any
  environment {
    IMAGE = "task-backend"
    TAG   = "${env.BUILD_NUMBER}"
  }
  stages {
    stage('Build & Test') {
      steps {
        dir('task-backend') {
          sh 'docker run --rm --network host -v "$PWD":/app -w /app maven:3.9-eclipse-temurin-21 mvn -B verify'
        }
      }
    }
    stage('Docker build') {
      steps {
        dir('task-backend') {
            sh 'docker build --network host -t $IMAGE:$TAG .'
        }
      }
    }
  }
  post {
    failure { echo 'Pipeline en échec' }
  }
}